# Server
PORT=4000
NODE_ENV=development

# University of Waterloo Open Data API v3. Register a key and confirm your email first.
# https://uwaterloo.atlassian.net/wiki/spaces/UWAPI/pages/34025641600/Getting+Started+-+OpenAPI
WATERLOO_API_KEY=

# LangChain's OpenAI chat model adapter (optional; the deterministic MCP demo works without it).
OPENAI_API_KEY=
LANGCHAIN_MODEL=openai:gpt-4.1-mini

# Display-only. The app does not require a student account.
VITE_STUDENT_NAME=Emily
